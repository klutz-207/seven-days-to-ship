"use client";

import { useEffect, useRef, useState } from "react";
import { SpriteAnimator } from "./SpriteAnimator";

type Direction = "down" | "up" | "left" | "right";
type ActionState = "idle" | "walk-right" | "walk-right-stop" | "walk-left" | "walk-left-stop";

interface Position {
  x: number;
  y: number;
}

interface CharacterSpriteProps {
  actionState: ActionState;
  containerWidth: number;
  containerHeight: number;
  /** 可行走区域（相对于容器的百分比） */
  walkableArea?: { x: number; y: number; width: number; height: number };
  /** 目标 X 位置（百分比 0-1），walk-right-stop / walk-left-stop 专用 */
  targetX?: number;
  /** 角色到达目标位置回调（walk-right-stop / walk-left-stop 专用） */
  onReachedTarget?: () => void;
}

// 精灵图帧定义
const SPRITE_FRAMES: Record<ActionState, Record<Direction, string[]>> = {
  idle: {
    down: ["/characters/programmer/idle-down-01.png"],
    up: ["/characters/programmer/idle-up-01.png"],
    left: ["/characters/programmer/idle-left-01.png"],
    right: ["/characters/programmer/idle-right-01.png"],
  },
  "walk-right": {
    down: ["/characters/programmer/idle-down-01.png"],
    up: ["/characters/programmer/idle-up-01.png"],
    left: [
      "/characters/programmer/walk-left-01.png",
      "/characters/programmer/walk-left-02.png",
      "/characters/programmer/walk-left-03.png",
      "/characters/programmer/walk-left-04.png",
    ],
    right: [
      "/characters/programmer/walk-right-01.png",
      "/characters/programmer/walk-right-02.png",
      "/characters/programmer/walk-right-03.png",
      "/characters/programmer/walk-right-04.png",
    ],
  },
  "walk-right-stop": {
    down: ["/characters/programmer/idle-down-01.png"],
    up: ["/characters/programmer/idle-up-01.png"],
    left: [
      "/characters/programmer/walk-left-01.png",
      "/characters/programmer/walk-left-02.png",
      "/characters/programmer/walk-left-03.png",
      "/characters/programmer/walk-left-04.png",
    ],
    right: [
      "/characters/programmer/walk-right-01.png",
      "/characters/programmer/walk-right-02.png",
      "/characters/programmer/walk-right-03.png",
      "/characters/programmer/walk-right-04.png",
    ],
  },
  "walk-left": {
    down: ["/characters/programmer/idle-down-01.png"],
    up: ["/characters/programmer/idle-up-01.png"],
    left: [
      "/characters/programmer/walk-left-01.png",
      "/characters/programmer/walk-left-02.png",
      "/characters/programmer/walk-left-03.png",
      "/characters/programmer/walk-left-04.png",
    ],
    right: [
      "/characters/programmer/walk-right-01.png",
      "/characters/programmer/walk-right-02.png",
      "/characters/programmer/walk-right-03.png",
      "/characters/programmer/walk-right-04.png",
    ],
  },
  "walk-left-stop": {
    down: ["/characters/programmer/idle-down-01.png"],
    up: ["/characters/programmer/idle-up-01.png"],
    left: [
      "/characters/programmer/walk-left-01.png",
      "/characters/programmer/walk-left-02.png",
      "/characters/programmer/walk-left-03.png",
      "/characters/programmer/walk-left-04.png",
    ],
    right: [
      "/characters/programmer/walk-right-01.png",
      "/characters/programmer/walk-right-02.png",
      "/characters/programmer/walk-right-03.png",
      "/characters/programmer/walk-right-04.png",
    ],
  },
};

const WALK_SPEED = 3;

export function CharacterSprite({
  actionState,
  containerWidth,
  containerHeight,
  walkableArea,
  targetX = 0.9,
  onReachedTarget,
}: CharacterSpriteProps) {
  const [position, setPosition] = useState<Position>({
    x: containerWidth * 0.1,
    y: containerHeight * 0.75,
  });
  const animFrameRef = useRef<number | null>(null);

  // 计算可行走边界
  const getBounds = () => {
    if (!walkableArea || containerWidth === 0) {
      return {
        minX: containerWidth * 0.1,
        maxX: containerWidth * 0.9,
        minY: containerHeight * 0.6,
        maxY: containerHeight * 0.85,
      };
    }
    return {
      minX: walkableArea.x * containerWidth,
      maxX: (walkableArea.x + walkableArea.width) * containerWidth,
      minY: walkableArea.y * containerHeight,
      maxY: (walkableArea.y + walkableArea.height) * containerHeight,
    };
  };

  // walk-right 模式：一直向右走，不停
  useEffect(() => {
    if (actionState !== "walk-right") return;

    const bounds = getBounds();
    const midY = (bounds.minY + bounds.maxY) / 2;

    // 从当前位置继续向右走，如果超出边界则重置到左侧
    setPosition((prev) => {
      if (prev.x >= bounds.maxX) {
        return { x: bounds.minX, y: midY };
      }
      return prev.y === midY ? prev : { x: prev.x, y: midY };
    });

    const walk = () => {
      setPosition((prev) => {
        const nextX = prev.x + WALK_SPEED;
        // 超出右边界后重置到左侧继续走
        if (nextX > bounds.maxX) {
          return { x: bounds.minX, y: prev.y };
        }
        return { x: nextX, y: prev.y };
      });
      animFrameRef.current = requestAnimationFrame(walk);
    };

    animFrameRef.current = requestAnimationFrame(walk);

    return () => {
      if (animFrameRef.current) {
        cancelAnimationFrame(animFrameRef.current);
      }
    };
  }, [actionState, containerWidth, containerHeight, walkableArea]);

  // walk-right-stop 模式：向右走到目标位置后停下
  useEffect(() => {
    if (actionState !== "walk-right-stop") return;

    const bounds = getBounds();
    const midY = (bounds.minY + bounds.maxY) / 2;
    const targetPx = bounds.minX + (bounds.maxX - bounds.minX) * targetX;
    let reached = false;

    // 确保 Y 位置正确
    setPosition((prev) => {
      return { x: prev.x, y: midY };
    });

    const walk = () => {
      setPosition((prev) => {
        if (reached) return prev;

        const dx = targetPx - prev.x;

        // 到达目标位置
        if (Math.abs(dx) < WALK_SPEED * 2) {
          reached = true;
          setTimeout(() => onReachedTarget?.(), 0);
          return { x: targetPx, y: prev.y };
        }

        return { x: prev.x + WALK_SPEED, y: prev.y };
      });

      if (!reached) {
        animFrameRef.current = requestAnimationFrame(walk);
      }
    };

    animFrameRef.current = requestAnimationFrame(walk);

    return () => {
      if (animFrameRef.current) {
        cancelAnimationFrame(animFrameRef.current);
      }
    };
  }, [actionState, containerWidth, containerHeight, walkableArea, targetX, onReachedTarget]);

  // walk-left 模式：一直向左走，不停
  useEffect(() => {
    if (actionState !== "walk-left") return;

    const bounds = getBounds();
    const midY = (bounds.minY + bounds.maxY) / 2;

    // 从当前位置继续向左走，如果超出边界则重置到右侧
    setPosition((prev) => {
      if (prev.x <= bounds.minX) {
        return { x: bounds.maxX, y: midY };
      }
      return prev.y === midY ? prev : { x: prev.x, y: midY };
    });

    const walk = () => {
      setPosition((prev) => {
        const nextX = prev.x - WALK_SPEED;
        // 超出左边界后重置到右侧继续走
        if (nextX < bounds.minX) {
          return { x: bounds.maxX, y: prev.y };
        }
        return { x: nextX, y: prev.y };
      });
      animFrameRef.current = requestAnimationFrame(walk);
    };

    animFrameRef.current = requestAnimationFrame(walk);

    return () => {
      if (animFrameRef.current) {
        cancelAnimationFrame(animFrameRef.current);
      }
    };
  }, [actionState, containerWidth, containerHeight, walkableArea]);

  // walk-left-stop 模式：向左走到目标位置后停下
  useEffect(() => {
    if (actionState !== "walk-left-stop") return;

    const bounds = getBounds();
    const midY = (bounds.minY + bounds.maxY) / 2;
    const targetPx = bounds.minX + (bounds.maxX - bounds.minX) * targetX;
    let reached = false;

    // 确保 Y 位置正确
    setPosition((prev) => {
      return { x: prev.x, y: midY };
    });

    const walk = () => {
      setPosition((prev) => {
        if (reached) return prev;

        const dx = targetPx - prev.x;

        // 到达目标位置
        if (Math.abs(dx) < WALK_SPEED * 2) {
          reached = true;
          setTimeout(() => onReachedTarget?.(), 0);
          return { x: targetPx, y: prev.y };
        }

        return { x: prev.x - WALK_SPEED, y: prev.y };
      });

      if (!reached) {
        animFrameRef.current = requestAnimationFrame(walk);
      }
    };

    animFrameRef.current = requestAnimationFrame(walk);

    return () => {
      if (animFrameRef.current) {
        cancelAnimationFrame(animFrameRef.current);
      }
    };
  }, [actionState, containerWidth, containerHeight, walkableArea, targetX, onReachedTarget]);

  // idle 模式：停下不动，无需额外逻辑

  const direction: Direction = actionState === "walk-left" || actionState === "walk-left-stop" ? "left" : "right";
  const frames = SPRITE_FRAMES[actionState][direction];

  const scale = 3.5;
  const width = 128 * scale;
  const height = 128 * scale;

  const zIndex = Math.floor(position.y);

  return (
    <div
      className="absolute"
      style={{
        left: position.x - width / 2,
        top: position.y - height,
        width,
        height,
        zIndex,
        imageRendering: "pixelated",
      }}
    >
      <SpriteAnimator
        frames={frames}
        fps={actionState === "idle" ? 4 : 10}
        loop={true}
        className="h-full w-full"
      />
    </div>
  );
}
